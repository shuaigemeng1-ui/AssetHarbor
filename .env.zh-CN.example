# Docker Compose 中文配置模板。
# 1. 将本文件复制为 .env。
# 2. 先填写第一节中的安全关键配置。
# 3. 生成的 .env 含有真实密钥，绝对不要提交或分享。
#
# 下列无前缀变量由 docker-compose.yml 读取。直接运行 Uvicorn 时，请使用
# 对应的 OSS_* 变量（例如 OSS_ADMIN_PASSWORD、OSS_JWT_SECRET）。

# --- 首次生产部署前必须填写 -----------------------------------------------
# 使用默认注册策略（ALLOW_REGISTRATION=closed）进行全新安装时必须填写。
# 该密码用于创建或更新内置 admin 账号。请使用唯一的强密码，新安装不要留空。
ADMIN_PASSWORD=

# 生产环境必须填写，用于保持登录态和私密媒体签名链接在重启后继续有效。
# 生成命令：openssl rand -hex 32
# 配置值必须至少包含 32 个 UTF-8 字节。留空仅适合临时开发：每次重启都会
# 生成新密钥，并使已有登录态和签名链接失效。
JWT_SECRET=

# --- 注册与登录 ------------------------------------------------------------
# open：开放注册；invite：邀请码注册；closed：关闭自主注册。
ALLOW_REGISTRATION=closed
# 仅在 ALLOW_REGISTRATION=invite 时必填，其他策略请留空。
INVITE_CODE=
# 登录令牌有效分钟数（1..525600；默认 7 天）。
TOKEN_EXPIRE_MINUTES=10080

# --- 网络与公开地址 --------------------------------------------------------
# bridge（默认）：将 PORT 映射到宿主机。
# host：直接使用宿主机网络（仅 Linux，端口映射会被忽略）。
NETWORK_MODE=bridge
PORT=8080
# 允许 Uvicorn 信任 X-Forwarded-* 的反向代理 IP/CIDR，多个值用逗号分隔。
# Nginx 或 Caddy 通过 Docker bridge 连接时，只填写实际代理或代理网段。
# 仅当外部无法直连且代理会覆盖转发头时，才可使用 *。
FORWARDED_ALLOW_IPS=127.0.0.1
# 示例：https://media.example.com。留空则根据当前请求自动推断。
PUBLIC_URL=

# --- 上传与存储限制 --------------------------------------------------------
# 单张图片上传上限，单位 MiB（1..1024）。
MAX_UPLOAD_SIZE_MB=10
# 视频原文件上限，单位 MiB（1..1048576；默认 2 GiB）。
MAX_VIDEO_SIZE_MB=2048
# 视频固定分片大小，单位 MiB（1..1024，且不得大于 MAX_VIDEO_SIZE_MB）。
# 反向代理的请求体限制必须大于此值和 MAX_UPLOAD_SIZE_MB，并预留 multipart
# 协议开销。
VIDEO_CHUNK_SIZE_MB=8
# 未完成视频上传的滑动有效期，单位小时（1..8760）。
VIDEO_UPLOAD_TTL_HOURS=168
# 每位用户可同时保留的未完成视频上传数（1..1000）。
MAX_ACTIVE_VIDEO_UPLOADS=3
# 单个 worker 同时接收的视频分片数（1..32）。
VIDEO_CHUNK_CONCURRENCY=3
# 磁盘剩余空间低于该值时拒绝写入，单位 MiB（0..1048576；0 表示禁用）。
MIN_FREE_SPACE_MB=1024
# 每用户“已完成媒体 + 未完成视频预留”总额度，单位 MiB。
# 范围：0..10485760；0 表示不限额。团队上传也会计入上传者额度。
USER_STORAGE_QUOTA_MB=0
# 每团队“已完成媒体 + 未完成视频预留”总额度，单位 MiB。
# 范围：0..10485760；0 表示不限额。团队上传必须同时满足用户和团队额度。
TEAM_STORAGE_QUOTA_MB=0

# --- 链接 ------------------------------------------------------------------
# 随机 base62 短码长度（6..32）。
SHORT_CODE_LENGTH=10
# 私密媒体签名链接有效秒数（60..604800）。
SIGNED_URL_TTL_SECONDS=86400

# --- 限流与 API Key --------------------------------------------------------
# 以下均为每 60 秒限制（0 表示禁用；最大值 1000000）。
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_USERNAME=5
REGISTRATION_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_USERNAME=3
IMAGES_RATE_LIMIT_PER_MINUTE=240
UPLOAD_RATE_LIMIT_PER_MINUTE=60
VIDEO_PART_RATE_LIMIT_PER_MINUTE=1000
# 每账号在当前进程固定 24 小时窗口内创建、轮换、撤销 API Key 的次数
#（1..100000；进程重启会重置该窗口）。
API_KEY_MUTATION_RATE_LIMIT_PER_DAY=100
# 每个账号可持有的有效 API Key 上限（1..1000）。
MAX_API_KEYS_PER_USER=20

# --- 维护 ------------------------------------------------------------------
# UTC 每日流量聚合数据保留天数（1..3650）。
TRAFFIC_RETENTION_DAYS=365
# 过期上传清理间隔秒数（1..604800）。
VIDEO_CLEANUP_INTERVAL_SECONDS=3600
# SQLite 写锁等待毫秒数（1..300000）。
SQLITE_BUSY_TIMEOUT_MS=5000
