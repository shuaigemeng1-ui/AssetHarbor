# --- Network mode ----------------------------------------------------------
# bridge (default): publish PORT from the container.
# host: use the host network directly (Linux only; the ports mapping is ignored).
NETWORK_MODE=bridge
PORT=8080

# --- Image uploads ---------------------------------------------------------
# Maximum size of the existing direct image-upload endpoint, in MiB.
MAX_UPLOAD_SIZE_MB=10

# --- Resumable video uploads -----------------------------------------------
# Maximum original video size, in MiB (default: 2 GiB).
MAX_VIDEO_SIZE_MB=2048
# Fixed part size returned by POST /api/video-uploads, in MiB.
# The reverse proxy request-body limit must be greater than this value.
VIDEO_CHUNK_SIZE_MB=8
# Sliding lifetime of an unfinished upload session, in hours (default: 7 days).
VIDEO_UPLOAD_TTL_HOURS=168
# Maximum number of unfinished video sessions owned by one user.
MAX_ACTIVE_VIDEO_UPLOADS=3
# Refuse image/video writes when less than this many MiB remain.
MIN_FREE_SPACE_MB=1024
# Interval between expired/incomplete video-upload cleanup passes, in seconds.
VIDEO_CLEANUP_INTERVAL_SECONDS=3600
# How long SQLite waits for a busy writer before failing, in milliseconds.
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Short links and public URL --------------------------------------------
SHORT_CODE_LENGTH=10
# Example: https://media.example.com. Empty means derive it from the request Host.
PUBLIC_URL=

# --- Authentication --------------------------------------------------------
# Bootstrap/update the built-in admin account. Use a strong password in production.
ADMIN_PASSWORD=
# open | invite | closed
# New installs are closed by default; explicitly use open only for public sign-up.
ALLOW_REGISTRATION=closed
INVITE_CODE=
# Self-registration rate limits per 60-second window.
REGISTRATION_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_USERNAME=3
# Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Visibility and signed links ------------------------------------------
# private | public
DEFAULT_VISIBILITY=private
SIGNED_URL_TTL_SECONDS=86400
