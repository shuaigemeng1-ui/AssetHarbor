# --- Network mode ----------------------------------------------------------
# bridge (default): publish PORT from the container.
# host: use the host network directly (Linux only; the ports mapping is ignored).
NETWORK_MODE=bridge
PORT=8080
# Comma-separated IPs/CIDRs of trusted reverse proxies whose X-Forwarded-*
# headers Uvicorn may honor. Keep 127.0.0.1 for direct exposure. When Nginx or
# Caddy connects over a Docker bridge, set only that proxy/network (never use *
# unless every direct connection is blocked and the proxy overwrites headers).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Image uploads ---------------------------------------------------------
# Maximum size of the existing direct image-upload endpoint, in MiB (1..1024).
MAX_UPLOAD_SIZE_MB=10

# --- Resumable video uploads -----------------------------------------------
# Maximum original video size, in MiB (1..1048576; default: 2 GiB).
MAX_VIDEO_SIZE_MB=2048
# Fixed part size returned by POST /api/video-uploads, in MiB (1..1024 and no
# larger than MAX_VIDEO_SIZE_MB). The proxy body limit must be greater than
# max(MAX_UPLOAD_SIZE_MB, VIDEO_CHUNK_SIZE_MB), with multipart overhead.
VIDEO_CHUNK_SIZE_MB=8
# Sliding lifetime of an unfinished upload session, in hours (1..8760).
VIDEO_UPLOAD_TTL_HOURS=168
# Maximum number of unfinished video sessions owned by one user (1..1000).
MAX_ACTIVE_VIDEO_UPLOADS=3
# Maximum simultaneous inbound video chunks for this single worker (1..32).
VIDEO_CHUNK_CONCURRENCY=3
# Refuse image/video writes when less than this many MiB remain (0 disables).
MIN_FREE_SPACE_MB=1024
# Per-user completed media + unfinished video reservations, in MiB
# (0..10485760; 0 means unlimited). Team uploads also count toward the user.
USER_STORAGE_QUOTA_MB=0
# Per-team completed media + unfinished video reservations, in MiB
# (0..10485760; 0 means unlimited). Team uploads must satisfy both quotas.
TEAM_STORAGE_QUOTA_MB=0
# Cleanup interval in seconds (1..604800).
VIDEO_CLEANUP_INTERVAL_SECONDS=3600
# SQLite busy-writer timeout in milliseconds (1..300000).
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Short links and public URL --------------------------------------------
# Base62 characters (6..32).
SHORT_CODE_LENGTH=10
# Example: https://media.example.com. Empty means derive it from the request Host.
PUBLIC_URL=

# --- Authentication --------------------------------------------------------
# Required on a fresh install while ALLOW_REGISTRATION=closed. Startup fails
# fast when the users table is empty and neither login nor registration is possible.
ADMIN_PASSWORD=
# open | invite | closed
# New installs are closed by default; explicitly use open only for public sign-up.
ALLOW_REGISTRATION=closed
INVITE_CODE=
# Token lifetime in minutes (1..525600).
TOKEN_EXPIRE_MINUTES=10080
# Rate limits per 60-second window (0 disables, maximum 1000000).
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_USERNAME=5
REGISTRATION_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_USERNAME=3
IMAGES_RATE_LIMIT_PER_MINUTE=240
UPLOAD_RATE_LIMIT_PER_MINUTE=60
# Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Visibility and signed links ------------------------------------------
# private | public
DEFAULT_VISIBILITY=private
# Signed-link lifetime in seconds (60..604800).
SIGNED_URL_TTL_SECONDS=86400
