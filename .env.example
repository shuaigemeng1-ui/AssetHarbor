# --- 端口（容器内固定监听 8080，这里映射到宿主机） ---
PORT=8080

# --- 单文件上传大小上限（MB） ---
MAX_UPLOAD_SIZE_MB=10

# --- 图片 URL 短码长度（base62 字符） ---
SHORT_CODE_LENGTH=10

# --- 返回给用户的完整链接前缀，例如 https://img.example.com ---
# 留空则自动从请求的 Host 推断（适合直接 IP + 端口访问）
PUBLIC_URL=

# --- 管理员账号（首次启动自动创建/刷新 admin 用户） ---
# 建议设置强密码；留空则不创建管理员（注册的普通用户无法管理）
ADMIN_PASSWORD=

# --- 注册策略：open（开放）/ invite（邀请码）/ closed（关闭） ---
ALLOW_REGISTRATION=open
INVITE_CODE=

# --- JWT 签名密钥（建议用 `openssl rand -hex 32` 生成随机长字符串） ---
# 留空则每次重启服务所有登录态失效
JWT_SECRET=
