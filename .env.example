# --- 网络模式 ---
# bridge：默认。容器使用独立 bridge 网络，通过端口映射访问（推荐，行为最可预期）
# host：直接使用宿主机网络（无端口映射，容器监听即宿主机监听）。
#        适用场景：需要绑定宿主机特定 IP、特殊网络环境、避免端口转发开销
NETWORK_MODE=bridge

# --- 端口（bridge 与 host 模式都生效） ---
# bridge 模式：宿主机映射端口
# host 模式：容器直接监听的宿主机端口
PORT=8080

# --- 单文件上传大小上限（MB） ---
MAX_UPLOAD_SIZE_MB=10

# --- 图片 URL 短码长度（base62 字符） ---
SHORT_CODE_LENGTH=10

# --- 返回给用户的完整链接前缀，例如 https://img.example.com ---
# 留空则自动从请求的 Host 推断（适合直接 IP + 端口访问）
PUBLIC_URL=

# --- 管理员账号（首次启动自动创建/刷新 admin 用户） ---
# 建议设置强密码；留空则不创建管理员（注册的普通用户无法管理）
ADMIN_PASSWORD=

# --- 注册策略：open（开放）/ invite（邀请码）/ closed（关闭） ---
ALLOW_REGISTRATION=open
INVITE_CODE=

# --- JWT 签名密钥（建议用 `openssl rand -hex 32` 生成随机长字符串） ---
# 留空则每次重启服务所有登录态失效
JWT_SECRET=

# --- 新上传图片的默认可见性：private（私密，仅自己/团队/管理员+签名链接）/ public（公开） ---
# 默认私密：上传后不会被人随手打开，分享需手动设为公开或用签名链接
DEFAULT_VISIBILITY=private

# --- 私密图签名链接有效期（秒，默认 24 小时） ---
SIGNED_URL_TTL_SECONDS=86400
