# Docker Compose configuration template.
# 1. Copy this file to .env.
# 2. Fill in the security-critical values in the first section.
# 3. Never commit or share the resulting .env file.
#
# These unprefixed names are consumed by docker-compose.yml. When running
# Uvicorn directly, use the OSS_* counterparts (for example,
# OSS_ADMIN_PASSWORD and OSS_JWT_SECRET).

# --- Fill before the first production deployment --------------------------
# Required for a fresh installation with the default registration policy
# (ALLOW_REGISTRATION=closed). Creates or updates the built-in admin account.
# Use a strong, unique password; do not leave it blank on a new installation.
ADMIN_PASSWORD=

# Required for stable production sessions and private-media signed links.
# Generate with: openssl rand -hex 32
# A configured value must contain at least 32 UTF-8 bytes. Leaving it empty is
# only suitable for temporary development: every restart generates a new key
# and invalidates existing logins and signed links.
JWT_SECRET=

# --- Registration and login ------------------------------------------------
# open: public sign-up; invite: invite-code sign-up; closed: no self sign-up.
ALLOW_REGISTRATION=closed
# Required when ALLOW_REGISTRATION=invite. Keep empty for other policies.
INVITE_CODE=
# Access-token lifetime in minutes (1..525600; default: 7 days).
TOKEN_EXPIRE_MINUTES=10080

# --- Network and public URL -------------------------------------------------
# bridge (default): publish PORT from the container.
# host: use the host network directly (Linux only; port mapping is ignored).
NETWORK_MODE=bridge
PORT=8080
# Comma-separated IPs/CIDRs of trusted reverse proxies whose X-Forwarded-*
# headers Uvicorn may honor. When Nginx or Caddy connects over a Docker bridge,
# set only that proxy/network. Never use * unless direct access is blocked and
# the proxy always overwrites forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1
# Example: https://media.example.com. Empty means derive it from the request.
PUBLIC_URL=

# --- Upload and storage limits ---------------------------------------------
# Maximum image-upload size in MiB (1..1024).
MAX_UPLOAD_SIZE_MB=10
# Maximum original video size in MiB (1..1048576; default: 2 GiB).
MAX_VIDEO_SIZE_MB=2048
# Fixed video part size in MiB (1..1024, never above MAX_VIDEO_SIZE_MB).
# Reverse-proxy request limits must exceed this and MAX_UPLOAD_SIZE_MB, with
# room for multipart overhead.
VIDEO_CHUNK_SIZE_MB=8
# Sliding lifetime of an unfinished video upload in hours (1..8760).
VIDEO_UPLOAD_TTL_HOURS=168
# Maximum unfinished video uploads owned by one user (1..1000).
MAX_ACTIVE_VIDEO_UPLOADS=3
# Maximum simultaneous inbound video parts for this single worker (1..32).
VIDEO_CHUNK_CONCURRENCY=3
# Reject writes below this free-disk reserve in MiB (0..1048576; 0 disables).
MIN_FREE_SPACE_MB=1024
# Per-user completed media plus unfinished video reservations, in MiB.
# Range: 0..10485760; 0 means unlimited. Team uploads also count against the
# uploader's quota.
USER_STORAGE_QUOTA_MB=0
# Per-team completed media plus unfinished video reservations, in MiB.
# Range: 0..10485760; 0 means unlimited. Team uploads must satisfy both user
# and team quotas.
TEAM_STORAGE_QUOTA_MB=0

# --- Links ------------------------------------------------------------------
# Random base62 short-code length (6..32).
SHORT_CODE_LENGTH=10
# Private-media signed-link lifetime in seconds (60..604800).
SIGNED_URL_TTL_SECONDS=86400

# --- Rate limits and API keys ----------------------------------------------
# Per-60-second limits (0 disables; maximum: 1000000).
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_USERNAME=5
REGISTRATION_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_USERNAME=3
IMAGES_RATE_LIMIT_PER_MINUTE=240
UPLOAD_RATE_LIMIT_PER_MINUTE=60
VIDEO_PART_RATE_LIMIT_PER_MINUTE=1000
# Per-account API-key create/rotate/revoke operations per in-process 24-hour
# window (1..100000; restarting the process resets this window).
API_KEY_MUTATION_RATE_LIMIT_PER_DAY=100
# Maximum active API keys per account (1..1000).
MAX_API_KEYS_PER_USER=20

# --- Maintenance ------------------------------------------------------------
# Retain UTC daily traffic aggregates for this many days (1..3650).
TRAFFIC_RETENTION_DAYS=365
# Expired-upload cleanup interval in seconds (1..604800).
VIDEO_CLEANUP_INTERVAL_SECONDS=3600
# SQLite writer-lock wait in milliseconds (1..300000).
SQLITE_BUSY_TIMEOUT_MS=5000
